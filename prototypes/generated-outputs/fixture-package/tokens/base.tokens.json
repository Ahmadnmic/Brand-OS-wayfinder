  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Fjord Sans",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Body and UI text"
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Fjord Display",
          "Georgia",
          "serif"
        ],
        "$description": "Headlines only"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.1,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.medium}",
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    }
  },
  "space": {
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "{color.palette.ink.900}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 8,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Resting card"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$type": "duration",
        "$value": {
          "value": 220,
          "unit": "ms"
        }
      }
    },
    "ease": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  }
}