      "kind": "font",
      "family": "Fjord Display",
      "provider": "google",
      "stylesheet": "https://fonts.googleapis.com/css2?family=Fraunces:wght@700&display=swap",
      "providerFamily": "Fraunces"
    }
  ],
  "references": [],
